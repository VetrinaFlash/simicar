{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simicar",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  // Non cancellare le variabili aggiunte dal pannello Cloudflare a ogni deploy
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Database e bucket vengono creati in automatico al primo deploy (provisioning di Wrangler).
  // Se preferisci crearli a mano: npx wrangler d1 create simicar-db e aggiungi qui "database_id".
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simicar-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "simicar-media" }],
  // Promemoria ritiri/riconsegne e scadenze flotta (ogni giorno alle 6:00 UTC)
  "triggers": { "crons": ["0 6 * * *"] },
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_SITE_URL": "https://noleggiomanhattan.it",
    "RESEND_FROM": "Manhattan Noleggio <prenotazioni@noleggiomanhattan.it>",
    "VAPID_SUBJECT": "mailto:prenotazioni@noleggiomanhattan.it",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": ""
  }
  // Segreti (npx wrangler secret put NOME):
  //   ADMIN_PASSWORD, RESEND_API_KEY, TURNSTILE_SECRET_KEY (facoltativo)
  //   VAPID, cron e salt IP sono generati automaticamente nel database (src/lib/secrets.ts)
  //   CARGOS_USERNAME, CARGOS_PASSWORD, CARGOS_API_KEY (facoltativi: invio automatico alla Polizia)
}
